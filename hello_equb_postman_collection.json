{
  "info": {
    "_postman_id": "b3e09874-5692-411a-a5f1-8319f37c35f9",
    "name": "Hello Equb API Collection",
    "description": "Complete Postman collection of all REST APIs used in hello-equb-web (Mobile & Web Flutter client).\n\nIncludes:\n- Authentication & Device Registration\n- Profile & Financial Information\n- Equbs (Types, Categories, Lists, Search, Detail, Status)\n- My Equbs, Equb History & Reports\n- Joining Equb & Payments (Bank Transfer, Telebirr, CBEBirr)\n- Lottery, Eligible Members & Claiming Prizes\n- Guarantors & Equb Requests\n- Corporate Equbs\n- Banners, App Promo, Notifications & Server Time\n- Telebirr SuperApp & CBEBirr Plus Mini-App Gateway Endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.hello-equb.com/api/v1",
      "type": "string"
    },
    {
      "key": "mediaUrl",
      "value": "https://api.hello-equb.com/",
      "type": "string"
    },
    {
      "key": "superappGatewayBaseUrl",
      "value": "https://196.188.120.5:38443/apiaccess/payment/gateway",
      "type": "string"
    },
    {
      "key": "cbeGatewayBaseUrl",
      "value": "https://api.hello-equb.com",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ekubId",
      "value": "",
      "type": "string"
    },
    {
      "key": "equberUserId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Authorization",
      "item": [
        {
          "name": "Send OTP (Phone Verification)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"+251911223344\",\n  \"otpLength\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/auth/otp",
              "host": ["{{baseUrl}}"],
              "path": ["user", "auth", "otp"]
            },
            "description": "Sends an OTP code via SMS to the specified phone number."
          }
        },
        {
          "name": "Sign Up (Register User)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "firstName", "value": "Abebe", "type": "text" },
                { "key": "middleName", "value": "Kebede", "type": "text" },
                { "key": "lastName", "value": "Tesfaye", "type": "text" },
                { "key": "phoneNumber", "value": "+251911223344", "type": "text" },
                { "key": "email", "value": "abebe@example.com", "type": "text" },
                { "key": "password", "value": "1234", "type": "text" },
                { "key": "ref", "value": "", "type": "text", "description": "Optional referral code" },
                { "key": "picture", "type": "file", "src": "", "description": "Optional profile picture" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/user/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["user", "auth", "signup"]
            },
            "description": "Registers a new user with name, phone, email, password/PIN, and optional photo/referral."
          }
        },
        {
          "name": "Login (PIN / Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken || (jsonData.data && jsonData.data.accessToken)) {",
                  "    var token = jsonData.accessToken || jsonData.data.accessToken;",
                  "    pm.collectionVariables.set('accessToken', token);",
                  "}",
                  "if (jsonData.refreshToken || (jsonData.data && jsonData.data.refreshToken)) {",
                  "    var rToken = jsonData.refreshToken || jsonData.data.refreshToken;",
                  "    pm.collectionVariables.set('refreshToken', rToken);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.collectionVariables.set('userId', jsonData.user.id);",
                  "} else if (jsonData.data && jsonData.data.user && jsonData.data.user.id) {",
                  "    pm.collectionVariables.set('userId', jsonData.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+251911223344\",\n  \"password\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["user", "auth", "login"]
            },
            "description": "Logs in user with phone number and PIN/password. Automatically sets accessToken, refreshToken, and userId collection variables."
          }
        },
        {
          "name": "Forgot Password (Request OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+251911223344\",\n  \"otpLength\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["user", "auth", "forgot-password"]
            },
            "description": "Initiates password reset by sending an OTP to the user's phone number or email."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"1234\",\n  \"password\": \"5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["user", "auth", "reset-password"]
            },
            "description": "Resets the user's password using the OTP received."
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{refreshToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["user", "auth", "refresh-token"]
            },
            "description": "Refreshes an expired JWT access token using the stored refresh token."
          }
        },
        {
          "name": "Get Auth Profile / Avatar",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/auth/",
              "host": ["{{baseUrl}}"],
              "path": ["user", "auth", ""]
            },
            "description": "Retrieves the authenticated user's session profile and avatar URL."
          }
        },
        {
          "name": "Update Device Token (Push Notifications)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"fcm_device_registration_token_here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/device-token",
              "host": ["{{baseUrl}}"],
              "path": ["user", "device-token"]
            },
            "description": "Registers Firebase Cloud Messaging (FCM) device token for push notifications."
          }
        }
      ]
    },
    {
      "name": "2. User Profile & Financial Information",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/profile/me",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile", "me"]
            },
            "description": "Fetches current user profile including completion rate, names, gender, phone, email, and avatar."
          }
        },
        {
          "name": "Update Personal Info",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "firstName", "value": "Abebe", "type": "text" },
                { "key": "middleName", "value": "Kebede", "type": "text" },
                { "key": "lastName", "value": "Tesfaye", "type": "text" },
                { "key": "gender", "value": "male", "type": "text" },
                { "key": "picture", "type": "file", "src": "", "description": "Optional profile avatar picture" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/user/profile/personal-info/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile", "personal-info", "{{userId}}"]
            },
            "description": "Updates personal details and avatar image for the user."
          }
        },
        {
          "name": "Get Banks List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/profile/banks",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile", "banks"]
            },
            "description": "Fetches list of supported commercial banks in Ethiopia."
          }
        },
        {
          "name": "Get User Bank Accounts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/profile/financial-info/",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile", "financial-info", ""]
            },
            "description": "Fetches bank accounts saved by the authenticated user."
          }
        },
        {
          "name": "Add Financial Info (Bank Account)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankId\": \"bank_uuid_here\",\n  \"accountName\": \"Abebe Kebede\",\n  \"accountNumber\": \"100012345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/profile/financial-info/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile", "financial-info", "{{userId}}"]
            },
            "description": "Adds a new payout bank account under user's profile."
          }
        },
        {
          "name": "Update Bank Account",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankId\": \"bank_uuid_here\",\n  \"accountName\": \"Abebe Kebede Tesfaye\",\n  \"accountNumber\": \"100012345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/profile/bank-account/:bankAccountId",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile", "bank-account", ":bankAccountId"],
              "variable": [
                {
                  "key": "bankAccountId",
                  "value": "bank_account_id_here"
                }
              ]
            },
            "description": "Updates an existing bank account of the user."
          }
        }
      ]
    },
    {
      "name": "3. Equbs (Types, Categories & Details)",
      "item": [
        {
          "name": "Get Equb Types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/equb-type",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb-type"]
            },
            "description": "Fetches all equb types (e.g. Regular, Finance, Other)."
          }
        },
        {
          "name": "Get Equb Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/equb-category",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb-category"]
            },
            "description": "Fetches equb categories (e.g. Daily, Weekly, Monthly)."
          }
        },
        {
          "name": "Get Equbs (Filtered by Type & Category)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/equb/?equbTypeId={{equbTypeId}}&equbCategoryId={{equbCategoryId}}&_page=1&_limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", ""],
              "query": [
                { "key": "equbTypeId", "value": "{{equbTypeId}}" },
                { "key": "equbCategoryId", "value": "{{equbCategoryId}}" },
                { "key": "_page", "value": "1" },
                { "key": "_limit", "value": "50" }
              ]
            },
            "description": "Lists available equbs filtered by type and category with pagination."
          }
        },
        {
          "name": "Search Equbs in Category",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/equb?_page=1&_limit=50&equbCategory=:categoryId&_search=1000",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb"],
              "query": [
                { "key": "_page", "value": "1" },
                { "key": "_limit", "value": "50" },
                { "key": "equbCategory", "value": ":categoryId" },
                { "key": "_search", "value": "1000" }
              ],
              "variable": [
                { "key": "categoryId", "value": "category_id_here" }
              ]
            },
            "description": "Searches running equbs within a category."
          }
        },
        {
          "name": "Get Equb Detail by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/equb/{{ekubId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", "{{ekubId}}"]
            },
            "description": "Fetches comprehensive details of a single equb."
          }
        },
        {
          "name": "Get Finance and Other Equbs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/equbs/getFinanceAndOtherMobile/{{userId}}?equbTypeId={{equbTypeId}}&equbCategoryId={{equbCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["equbs", "getFinanceAndOtherMobile", "{{userId}}"],
              "query": [
                { "key": "equbTypeId", "value": "{{equbTypeId}}" },
                { "key": "equbCategoryId", "value": "{{equbCategoryId}}" }
              ]
            },
            "description": "Returns special Finance & Other equbs for mobile/web."
          }
        },
        {
          "name": "Get Saving Equb Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/equb/savingMember/{{ekubId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", "savingMember", "{{ekubId}}"]
            },
            "description": "Gets details of saving-type equb member participation."
          }
        },
        {
          "name": "Check If User Has Joined Equb",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equbId\": \"{{ekubId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/equb/check-join",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", "check-join"]
            },
            "description": "Checks if the logged-in user is already a member of this equb."
          }
        },
        {
          "name": "Get User Equb Stakes Count",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/equb/userEqub/{{ekubId}}/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", "userEqub", "{{ekubId}}", "{{userId}}"]
            },
            "description": "Checks joined shares/stakes count for a specific user in an equb."
          }
        }
      ]
    },
    {
      "name": "4. My Equbs & History",
      "item": [
        {
          "name": "Get All Joined Equbs (Paged)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/equb/getAllJoinedEqubs?_page=1&_limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", "getAllJoinedEqubs"],
              "query": [
                { "key": "_page", "value": "1" },
                { "key": "_limit", "value": "10" }
              ]
            },
            "description": "Fetches all equbs the current user has joined across all categories."
          }
        },
        {
          "name": "Get My Joined Equbs (By Status)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/equb?user={{userId}}&status=joined&_page=1&_limit=200&equbType=&equbCategory=",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb"],
              "query": [
                { "key": "user", "value": "{{userId}}" },
                { "key": "status", "value": "joined" },
                { "key": "_page", "value": "1" },
                { "key": "_limit", "value": "200" },
                { "key": "equbType", "value": "" },
                { "key": "equbCategory", "value": "" }
              ]
            },
            "description": "Filters joined equbs for the active user, with optional type/category filters."
          }
        },
        {
          "name": "Get Equb History (All Joined Equbs)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/equb/get-history-equbs?user={{userId}}&_page=1&_limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", "get-history-equbs"],
              "query": [
                { "key": "user", "value": "{{userId}}" },
                { "key": "_page", "value": "1" },
                { "key": "_limit", "value": "20" }
              ]
            },
            "description": "Retrieves user's equb participation history (registering, active, completed)."
          }
        },
        {
          "name": "Get Equb Statement / Report (PDF data)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/report/:type",
              "host": ["{{baseUrl}}"],
              "path": ["user", "report", ":type"],
              "variable": [
                { "key": "type", "value": "all", "description": "e.g. all, monthly, weekly" }
              ]
            },
            "description": "Fetches report data used to generate downloadable PDF receipts/statements."
          }
        }
      ]
    },
    {
      "name": "5. Joining, Payments & Transactions",
      "item": [
        {
          "name": "Join Equb (Standard)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paidAmount\": 1000,\n  \"paymentMethod\": \"cbe\",\n  \"equbers\": [\n    {\n      \"stake\": 1,\n      \"paidAmount\": 1000\n    }\n  ],\n  \"phoneNumber\": \"+251911223344\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/equb/join/{{ekubId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", "join", "{{ekubId}}"]
            },
            "description": "Standard endpoint to join an equb with specified shares and payment method (cbe, telebirr, or bankTransfer)."
          }
        },
        {
          "name": "Join Equb (Mini-App Direct Pay)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paidAmount\": 1000,\n  \"paymentMethod\": \"telebirr\",\n  \"phoneNumber\": \"+251911223344\",\n  \"equbers\": [\n    {\n      \"stake\": 1,\n      \"paidAmount\": 1000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/equb/joinMiniApp/{{ekubId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", "joinMiniApp", "{{ekubId}}"]
            },
            "description": "Direct in-app payment request for Telebirr SuperApp and CBEBirr Plus Mini-App."
          }
        },
        {
          "name": "Make Round Payment (Standard)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paidAmount\": 1000,\n  \"paymentMethod\": \"cbe\",\n  \"lottery\": [\n    {\n      \"id\": \"user_lottery_id\",\n      \"paidAmount\": 1000\n    }\n  ],\n  \"phoneNumber\": \"+251911223344\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/equb/payment/{{ekubId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "equb", "payment", "{{ekubId}}"]
            },
            "description": "Submits regular round/lottery payment for an active equb."
          }
        },
        {
          "name": "Make Round Payment (Mini-App Direct Pay)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
